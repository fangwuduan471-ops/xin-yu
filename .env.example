# Never commit .env or .env.local files containing real secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/xinyu?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
# Set both values before closed-beta deployment. Keep the invite code private.
BETA_MODE=true
BETA_INVITE_CODE="replace-with-a-long-private-invite-code"
POSTGRES_PASSWORD="replace-with-a-strong-local-password"
# Set these only temporarily when running `pnpm admin:bootstrap`; do not commit them.
ADMIN_EMAIL=""
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
