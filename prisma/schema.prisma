generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum WorkStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  TAKEN_DOWN
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ReportTargetType {
  WORK
  COMMENT
  USER
}

enum ReportReason {
  PORNOGRAPHY
  VIOLENCE
  HARMFUL_INDUCEMENT
  SPAM
  COPYRIGHT
  HARASSMENT
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum RestrictionType {
  COMMENT_BAN
  PUBLISH_BAN
  ACCOUNT_BAN
}

model User {
  id              String          @id @default(cuid())
  username        String          @unique @db.VarChar(24)
  email           String          @unique @db.VarChar(320)
  passwordHash    String?         @map("password_hash")
  avatarUrl       String?         @map("avatar_url") @db.VarChar(2048)
  bio             String?         @db.VarChar(240)
  role            Role            @default(USER)
  status          UserStatus      @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  accounts        Account[]
  sessions        Session[]
  works           Work[]
  comments        Comment[]
  likes           WorkLike[]
  collections     Collection[]
  reports         Report[]        @relation("ReportReporter")
  handledReports  Report[]        @relation("ReportHandler")
  restrictions    UserRestriction[] @relation("RestrictedUser")
  imposedRestrictions UserRestriction[] @relation("RestrictionOperator")
  auditLogs       AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(32)
  slug        String   @unique @db.VarChar(48)
  description String?  @db.VarChar(160)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  works       Work[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Tag {
  id         String    @id @default(cuid())
  name       String    @unique @db.VarChar(32)
  slug       String    @unique @db.VarChar(48)
  usageCount Int       @default(0) @map("usage_count")
  works      WorkTag[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("tags")
}

model Work {
  id                String      @id @default(cuid())
  title             String      @db.VarChar(120)
  slug              String      @unique @db.VarChar(150)
  summary           String      @db.VarChar(300)
  contentMarkdown   String      @map("content_markdown") @db.Text
  contentHtml       String?     @map("content_html") @db.Text
  authorId          String      @map("author_id")
  categoryId        String      @map("category_id")
  status            WorkStatus  @default(DRAFT)
  moderationReason  String?     @map("moderation_reason") @db.VarChar(500)
  publishedAt       DateTime?   @map("published_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  author            User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category          Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags              WorkTag[]
  comments          Comment[]
  likes             WorkLike[]
  collections       Collection[]
  versions          WorkVersion[]
  metrics           WorkMetricDaily[]

  @@index([status, publishedAt])
  @@index([authorId, status])
  @@index([categoryId, status])
  @@map("works")
}

model WorkTag {
  workId String @map("work_id")
  tagId  String @map("tag_id")
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workId, tagId])
  @@map("work_tags")
}

model WorkVersion {
  id              String   @id @default(cuid())
  workId          String   @map("work_id")
  title           String   @db.VarChar(120)
  summary         String   @db.VarChar(300)
  contentMarkdown String   @map("content_markdown") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  work            Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId, createdAt])
  @@map("work_versions")
}

model Comment {
  id        String        @id @default(cuid())
  workId    String        @map("work_id")
  authorId  String        @map("author_id")
  content   String        @db.VarChar(1000)
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")
  work      Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workId, createdAt])
  @@map("comments")
}

model WorkLike {
  userId    String   @map("user_id")
  workId    String   @map("work_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([userId, workId])
  @@index([workId, createdAt])
  @@map("work_likes")
}

model Collection {
  userId    String   @map("user_id")
  workId    String   @map("work_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([userId, workId])
  @@index([workId, createdAt])
  @@map("collections")
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String           @map("reporter_id")
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id")
  reason      ReportReason
  description String?          @db.VarChar(500)
  status      ReportStatus     @default(OPEN)
  handlerId   String?          @map("handler_id")
  resolution  String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at")
  resolvedAt  DateTime?        @map("resolved_at")
  reporter    User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  handler     User?            @relation("ReportHandler", fields: [handlerId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model UserRestriction {
  id         String          @id @default(cuid())
  userId     String          @map("user_id")
  operatorId String          @map("operator_id")
  type       RestrictionType
  reason     String          @db.VarChar(500)
  startsAt   DateTime        @default(now()) @map("starts_at")
  endsAt     DateTime?       @map("ends_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  user       User            @relation("RestrictedUser", fields: [userId], references: [id], onDelete: Cascade)
  operator   User            @relation("RestrictionOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([userId, endsAt])
  @@map("user_restrictions")
}

model WorkMetricDaily {
  id              String   @id @default(cuid())
  workId          String   @map("work_id")
  day             DateTime @db.Date
  viewCount       Int      @default(0) @map("view_count")
  likeCount       Int      @default(0) @map("like_count")
  collectionCount Int      @default(0) @map("collection_count")
  commentCount    Int      @default(0) @map("comment_count")
  work            Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, day])
  @@map("work_metrics_daily")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(32)
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
